{
  "name": "video-studio",
  "version": "0.5.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/CRCAT25/video-studio.git"
  },
  "license": "MIT",
  "private": true,
  "description": "Xưởng sản xuất video chạy local: điều phối Claude Code (claude -p) làm video theo từng bước của preset.",
  "type": "module",
  "bin": {
    "video-studio": "server/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/cli.js",
    "service:install": "node server/cli.js service install",
    "service:uninstall": "node server/cli.js service uninstall",
    "service:restart": "node server/cli.js service restart",
    "service:status": "node server/cli.js service status",
    "open": "node server/cli.js service open",
    "dev:server": "node server/cli.js --dev",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "test": "node --test test/*.test.js",
    "e2e": "node test/e2e/run.mjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.1",
    "tinyglobby": "^0.2.15",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "^5.2.10",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright-core": "^1.48.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.1.12"
  }
}
